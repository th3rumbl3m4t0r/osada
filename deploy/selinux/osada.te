policy_module(osada, 1.4)

# osada, its reverse ssh tunnel to the public edge, and the apk page (port 88),
# each in a domain of its own; install.sh loads this and labels the files

########################################
#
# Declarations
#

type osada_t;
type osada_exec_t;
init_daemon_domain(osada_t, osada_exec_t)
init_nnp_daemon_domain(osada_t)

# OSADA_DATA: database, secret.key, user files, thumbnails, edge certificate
type osada_data_t;
files_type(osada_data_t)

# /etc/osada; systemd reads osada.env as well
type osada_conf_t;
files_config_file(osada_conf_t)

# osada 0.2: the node links (QUIC over UDP, OSADA_LINK_BIND, 7441); install.sh
# labels udp/7441 with it
type osada_link_port_t;
corenet_port(osada_link_port_t)

# sqlite's temp files, in the unit's PrivateTmp
type osada_tmp_t;
files_tmp_file(osada_tmp_t)

type osada_tunnel_t;
type osada_tunnel_exec_t;
init_daemon_domain(osada_tunnel_t, osada_tunnel_exec_t)
init_nnp_daemon_domain(osada_tunnel_t)

# the tunnel's key and edge1's host key; not for osada itself
type osada_tunnel_key_t;
files_type(osada_tunnel_key_t)

type osada_apk_t;
type osada_apk_exec_t;
init_daemon_domain(osada_apk_t, osada_apk_exec_t)
init_nnp_daemon_domain(osada_apk_t)

# /srv/osada-apk, written by android/publish.sh
type osada_apk_content_t;
files_type(osada_apk_content_t)

########################################
#
# osada
#

allow osada_t self:capability net_bind_service;
allow osada_t self:process { getsched signal_perms };
allow osada_t self:fifo_file rw_fifo_file_perms;
allow osada_t self:unix_stream_socket create_stream_socket_perms;
allow osada_t self:tcp_socket create_stream_socket_perms;

files_search_home(osada_t)
manage_dirs_pattern(osada_t, osada_data_t, osada_data_t)
manage_files_pattern(osada_t, osada_data_t, osada_data_t)
manage_lnk_files_pattern(osada_t, osada_data_t, osada_data_t)
# sqlite maps shelf.db-shm
allow osada_t osada_data_t:file map;

read_files_pattern(osada_t, osada_conf_t, osada_conf_t)

manage_dirs_pattern(osada_t, osada_tmp_t, osada_tmp_t)
manage_files_pattern(osada_t, osada_tmp_t, osada_tmp_t)
files_tmp_filetrans(osada_t, osada_tmp_t, { file dir })

# the backup keeps a copy of the unit
systemd_read_unit_files(osada_t)

# OSADA_BIND (80) and OSADA_EDGE_BIND (8080)
corenet_tcp_bind_generic_node(osada_t)
corenet_tcp_bind_http_port(osada_t)
corenet_tcp_bind_http_cache_port(osada_t)
# SFTP mounts and the backup target
corenet_tcp_connect_ssh_port(osada_t)
# AS number lookups at stat.ripe.net
corenet_tcp_connect_http_port(osada_t)
# egress (Round 19): as the exit node of other nodes' containers and jobs, connections out to
# whatever they ask for (egress.rs: not to loopback, link-local or multicast addresses)
corenet_tcp_connect_all_ports(osada_t)
# the UPS status page (OSADA_UPS_URL, port 8765)
corenet_tcp_connect_lirc_port(osada_t)
sysnet_dns_name_resolve(osada_t)
# osada 0.2: node links over QUIC on UDP: bound on OSADA_LINK_BIND (7441), home
# dials the edge from the same socket
allow osada_t self:udp_socket create_socket_perms;
corenet_udp_bind_generic_node(osada_t)
allow osada_t osada_link_port_t:udp_socket name_bind;

# the hostname, the worker count, free space
kernel_read_kernel_sysctls(osada_t)
fs_search_cgroup_dirs(osada_t)
fs_read_cgroup_files(osada_t)
dev_read_sysfs(osada_t)
# what a node says of itself (load, memory), what listens and the default route (D-U34, D-U35)
kernel_read_system_state(osada_t)
kernel_read_network_state(osada_t)
fs_getattr_xattr_fs(osada_t)

miscfiles_read_localization(osada_t)
logging_send_syslog_msg(osada_t)

########################################
#
# osada-tunnel: a shell script that execs ssh, which stays in this domain
#

allow osada_tunnel_t self:fifo_file rw_fifo_file_perms;
allow osada_tunnel_t self:unix_stream_socket create_stream_socket_perms;
allow osada_tunnel_t self:tcp_socket create_stream_socket_perms;

corecmd_exec_shell(osada_tunnel_t)
ssh_exec(osada_tunnel_t)

allow osada_tunnel_t osada_conf_t:dir search_dir_perms;
read_files_pattern(osada_tunnel_t, osada_tunnel_key_t, osada_tunnel_key_t)

corenet_tcp_connect_ssh_port(osada_tunnel_t)
# edge1's connections come out at the edge listener, 127.0.0.1:8080
corenet_tcp_connect_http_cache_port(osada_tunnel_t)
sysnet_dns_name_resolve(osada_tunnel_t)

# ssh_config and the crypto policy it includes
files_read_etc_files(osada_tunnel_t)
files_read_usr_files(osada_tunnel_t)
dev_read_urand(osada_tunnel_t)
auth_use_nsswitch(osada_tunnel_t)
miscfiles_read_localization(osada_tunnel_t)
logging_send_syslog_msg(osada_tunnel_t)

# ssh looks for ~/.ssh; osada's home has none and the tunnel needs none
files_search_home(osada_tunnel_t)
dontaudit osada_tunnel_t osada_data_t:dir search_dir_perms;

########################################
#
# osada-apk: serve.py, run by python3
#

allow osada_apk_t self:capability net_bind_service;
allow osada_apk_t self:fifo_file rw_fifo_file_perms;
allow osada_apk_t self:unix_stream_socket create_stream_socket_perms;
allow osada_apk_t self:tcp_socket create_stream_socket_perms;

corecmd_exec_bin(osada_apk_t)
files_read_usr_files(osada_apk_t)

files_search_var(osada_apk_t)
list_dirs_pattern(osada_apk_t, osada_apk_content_t, osada_apk_content_t)
read_files_pattern(osada_apk_t, osada_apk_content_t, osada_apk_content_t)

# port 88 is labelled kerberos_port_t
corenet_tcp_bind_generic_node(osada_apk_t)
corenet_tcp_bind_kerberos_port(osada_apk_t)
# the server looks up its own name at start; nss-myhostname checks whether
# IPv6 is on
sysnet_dns_name_resolve(osada_apk_t)
auth_use_nsswitch(osada_apk_t)
kernel_read_network_state_symlinks(osada_apk_t)
kernel_read_net_sysctls(osada_apk_t)

miscfiles_read_localization(osada_apk_t)
logging_send_syslog_msg(osada_apk_t)
