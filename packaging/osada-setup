if webmail:
    mine = [a for a in call("x:Application/get", {}).get("list", []) if "/maildot" in (a.get("urlPrefix") or {})]
    if not mine:
        one("x:Application/set", {"create": {"w": {"enabled": True, "description": "maildot webmail", "resourceUrl": webmail, "urlPrefix": {"/maildot": True}}}}, "the webmail")
