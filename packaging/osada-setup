#!/bin/bash
# osada 0.2 on a machine with systemd (RHEL, Rocky, Alma, CentOS Stream 9-10, Fedora, Debian 12+,
# Ubuntu 22.04+). Run as root: osada-setup from the package (dnf/apt install osada), or
# ./osada-setup in an unpacked tarball; see INSTALL.md (/usr/share/doc/osada/INSTALL.md).
# A node can be anywhere (a cloud VM, a machine on a local network, several on one network): what
# it does is what you give it here, not where it is. No node needs a particular name.
#
#   osada-setup first [--name <node>] [--edge [--address <addr>] [--edge-name <node>]]
#                [--public-name osada.example.org] [--http 127.0.0.1:8096] [--link 0.0.0.0:7441]
#       a new cluster: this machine is its first node (sign-in, directory, files, every role),
#       named after the machine unless --name; its first administrator is `admin` (password in
#       /var/lib/osada/node/first-admin). Its pages (plain http) are on 127.0.0.1:8096 unless --http
#       (e.g. 0.0.0.0:80 to serve a local network directly); https is the edges'.
#       --edge: this machine answers the public names too (a second node, <name>-edge, on 443 and
#       80, its link on 7442, dialed at --address: this machine's first IPv4 by default);
#       --public-name: the instance's name (its address, UPN domain, sign-in issuer), and with
#       --edge a certificate for it
#   osada-setup token --name <node> [--at <its address>] [--roles edge-http,idp,store,blob,worker] [--hours 1]
#       on the first node: a one-time token for another node; with --at the first node dials it (for
#       the join and from then on), without it the new node dials the first node (node --peer)
#   osada-setup node --name <node> --token <token> [--edge] [--peer <first node>@<host>:7441] [--link 0.0.0.0:7441]
#       another machine joins the cluster; --edge: it answers the public names (443, 80)
#   osada-setup cert --names osada.example.org[,more.example.org] [--cert osada] [--issuer-node <edge>]
#       on the first node: a certificate for the public names (Let's Encrypt), issued by an edge and
#       copied to the others; the first name becomes the instance's name if it has none yet
#   osada-setup mail [--domain example.org] [--host mail.example.org] [--contact postmaster@example.org] [--no-oidc]
#       on the mail machine (a node the internet reaches on 25, 465, 587, 993 and 443: an edge):
#       Stalwart, the mail server, set up whole: its name, the domain, Let's Encrypt, DKIM, the
#       webmail (https://<host>/maildot/) signing in with osada, and the mail instance in the
#       cluster; it prints the DNS records to publish. --domain: by default the first name of the
#       certificates this node has (the instance's name); --host: mail.<domain>
#   osada-setup upgrade
#       this package's binary in place of the installed one, and the services restarted
#       (every node: the edges first, the first node last)
#
# Also: --selinux (load osada's SELinux module: osada runs confined), --firewall (open the ports
# in firewalld or ufw, whichever runs), --no-start, --dry-run (show what would be done), --root
# <dir> (install into a tree instead of /: for tests; no users, no services).
# It makes and changes; it never deletes anything.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
# the program: the package's (/usr/bin/osada, dnf/apt), or this unpacked tarball's, installed as
# /usr/local/bin/osada; how to call this script in what it prints
if [ -x /usr/bin/osada ] && [ ! -e "$HERE/osada" ]; then
    PACKAGED=1; BIN=/usr/bin/osada; SELF=osada-setup
else
    PACKAGED=0; BIN=/usr/local/bin/osada; SELF=./osada-setup
fi
cmd=${1:-}
[ -n "$cmd" ] && shift || true

NAME=""; HTTP=""; LINK="0.0.0.0:7441"; ISSUER=""; PEER=""; TOKEN=""; ROLES="edge-http,idp,store,blob,worker"; HOURS=1; AT=""; WAIT=30
EDGE=0; SELINUX=0; FIREWALL=0; START=1; DRY=0; ROOT=""; PUBLIC=""; PUBLIC_NAME=""; NAMES=""; CERT=osada; CERT_ISSUER=""; EDGE_NAME=""; STALWART=0.16.27
DOMAIN=""; MAILHOST=""; CONTACT=""; OIDC=1
while [ $# -gt 0 ]; do
    case "$1" in
        --name) NAME=$2; shift 2 ;;
        --http) HTTP=$2; shift 2 ;;
        --link) LINK=$2; shift 2 ;;
        --issuer) ISSUER=$2; shift 2 ;;
        --peer) PEER=$2; shift 2 ;;
        --token) TOKEN=$2; shift 2 ;;
        --roles) ROLES=$2; shift 2 ;;
        --hours) HOURS=$2; shift 2 ;;
        --at) AT=$2; shift 2 ;;
        --address|--public) PUBLIC=$2; shift 2 ;;
        --public-name) PUBLIC_NAME=$2; shift 2 ;;
        --names) NAMES=$2; shift 2 ;;
        --cert) CERT=$2; shift 2 ;;
        --issuer-node) CERT_ISSUER=$2; shift 2 ;;
        --edge-name) EDGE_NAME=$2; shift 2 ;;
        --stalwart) STALWART=$2; shift 2 ;;
        --domain) DOMAIN=$2; shift 2 ;;
        --host) MAILHOST=$2; shift 2 ;;
        --contact) CONTACT=$2; shift 2 ;;
        --no-oidc) OIDC=0; shift ;;
        --wait) WAIT=$2; shift 2 ;;
        --edge) EDGE=1; shift ;;
        --selinux) SELINUX=1; shift ;;
        --firewall) FIREWALL=1; shift ;;
        --no-start) START=0; shift ;;
        --dry-run) DRY=1; shift ;;
        --root) ROOT=$(realpath -m "$2"); shift 2 ;;
        *) echo "unknown option $1 (see the top of $0)" >&2; exit 2 ;;
    esac
done

say() { printf '\033[1m%s\033[0m\n' "$*"; }
run() {
    echo "  + $*"
    [ "$DRY" = 1 ] || "$@"
}
# a file with this content, when it is not there yet (an existing one is kept and said so)
put() {
    local path="$ROOT$1" mode=$2 content=$3
    if [ -e "$path" ]; then
        echo "  = $1 is there already: kept (the new one would be $1.new)"
        [ "$DRY" = 1 ] || { printf '%s' "$content" > "$path.new"; chmod "$mode" "$path.new"; }
        return
    fi
    echo "  + $1"
    [ "$DRY" = 1 ] && return
    mkdir -p "$(dirname "$path")"
    printf '%s' "$content" > "$path"
    chmod "$mode" "$path"
}
real() { [ -z "$ROOT" ] && [ "$DRY" = 0 ]; }
# this machine's first IPv4 on an interface, whatever network it is on
my_addr() {
    command -v ip >/dev/null || return 0
    ip -o -4 addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1
}
# a node name from this machine's name (small letters, digits, -; starting with a letter)
host_name() {
    local n
    n=$(hostname -s 2>/dev/null | tr 'A-Z_.' 'a-z--' | tr -cd 'a-z0-9-' | sed 's/^[^a-z]*//' | cut -c1-26)
    echo "${n:-node}"
}
# the instance's name (its address: links, federation, the UPN domain; the sign-in issuer) into
# osada.env when it has none; true when it was added
set_public() { # env file, host name
    grep -q '^OSADA_PUBLIC_URL=' "$1" && return 1
    say "the instance's name: $2 (OSADA_PUBLIC_URL, OSADA_OIDC_ISSUER in $1)"
    [ "$DRY" = 1 ] && return 0
    printf '# the instance: its address (links, federation, the UPN domain) and its sign-in issuer\nOSADA_PUBLIC_URL=https://%s\n' "$2" >> "$1"
    grep -q '^OSADA_OIDC_ISSUER=' "$1" || printf 'OSADA_OIDC_ISSUER=https://%s\n' "$2" >> "$1"
    return 0
}
valid_hosts() { [[ "$1" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(,[a-z0-9]([a-z0-9.-]*[a-z0-9])?)*$ ]]; }
# a change to node control (osada web import): sites, certificates, the mail instance
node_import() { # node folder, its account, json, what (said)
    local dir=$1 user=$2 json=$3 tmp
    echo "  + osada web import ($4)"
    [ "$DRY" = 1 ] && return 0
    tmp=$(mktemp --suffix=.json /tmp/osada-import.XXXXXX)
    printf '%s\n' "$json" > "$tmp"
    chmod 644 "$tmp"
    rm -f "$dir/web-import.done" "$dir/web-import.failed"
    runuser -u "$user" -- $BIN web import "$tmp" --data "$dir" >/dev/null
    rm -f "$tmp"
    for _ in $(seq 1 15); do
        if [ -e "$dir/web-import.done" ]; then echo "  = $(cat "$dir/web-import.done")"; return 0; fi
        if [ -e "$dir/web-import.failed" ]; then echo "  ! $(cat "$dir/web-import.failed")" >&2; return 1; fi
        sleep 1
    done
    echo "  ! the node did not take it within 15 s (journalctl -u osada, -u osada-node)" >&2
    return 1
}
# a certificate for host names, into node control (on the first node)
cert_import() { # node folder, cert name, names (a,b), issuer node (may be empty)
    local name=$2 names=$3 issuer=$4
    node_import "$1" osada "{\"certs\":{\"$name\":{\"names\":[\"${names//,/\",\"}\"]${issuer:+,\"issuer\":\"$issuer\"}}}}" \
        "certs: $name = $names${issuer:+, issued by $issuer}"
}
port_of() { echo "${1##*:}"; }
valid_name() { [[ "$1" =~ ^[a-z][a-z0-9-]{0,31}$ ]]; }

need_root() {
    if [ -z "$ROOT" ] && [ "$DRY" = 0 ] && [ "$(id -u)" != 0 ]; then
        echo "run it as root (or with --dry-run, --root <dir>)" >&2
        exit 1
    fi
}

check_binary() {
    local b=$BIN
    [ "$PACKAGED" = 1 ] || b=$HERE/osada
    if ! "$b" version >/dev/null 2>&1; then
        echo "the osada binary does not run here (it needs glibc 2.34 or newer, x86_64)" >&2
        exit 1
    fi
    "$b" version | sed -n 1p
}

install_binary() {
    if [ "$PACKAGED" = 1 ]; then
        echo "  = the program: $BIN (the package's)"
        return
    fi
    say "the program: $BIN"
    run mkdir -p "$ROOT/usr/local/bin"
    run install -m 755 "$HERE/osada" "$ROOT$BIN"
}

make_user() { # user home
    if [ -n "$ROOT" ]; then
        echo "  (--root: no account $1; its folder $2)"
        run mkdir -p "$ROOT$2"
        return
    fi
    if id "$1" >/dev/null 2>&1; then
        echo "  = account $1 is there"
    else
        local nologin=/usr/sbin/nologin
        [ -x "$nologin" ] || nologin=/sbin/nologin
        run useradd --system --home-dir "$2" --create-home --shell "$nologin" "$1"
    fi
    run install -d -m 750 -o "$1" -g "$1" "$2"
}

open_ports() { # "8096/tcp 7441/udp …" or services "http https"
    [ "$FIREWALL" = 1 ] || { echo "  (ports to open, unless --firewall: $*)"; return; }
    if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
        for p in "$@"; do
            case "$p" in
                */*) run firewall-cmd --permanent --add-port="$p" ;;
                *) run firewall-cmd --permanent --add-service="$p" ;;
            esac
        done
        run firewall-cmd --reload
    elif command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
        # Ubuntu's: rules are kept across reboots; "ufw status" lists them (comment osada)
        for p in "$@"; do
            case "$p" in
                http) p=80/tcp ;;
                https) p=443/tcp ;;
            esac
            run ufw allow "$p" comment osada
        done
    else
        echo "  no firewall runs here (firewalld, ufw): nothing to open on this VM. If your provider"
        echo "  has a firewall of its own (a cloud firewall, a security group), allow there: $*"
    fi
}

selinux_module() { # data folder
    [ "$SELINUX" = 1 ] || return 0
    if [ "$PACKAGED" = 1 ] || [ ! -e "$HERE/selinux/osada.te" ]; then
        echo "  --selinux: osada's SELinux module is not part of this release yet; osada runs"
        echo "  unconfined (unconfined_service_t), which works with SELinux enforcing"
        return 0
    fi
    if ! command -v getenforce >/dev/null || [ "$(getenforce)" = Disabled ]; then
        echo "  SELinux is off here: nothing to load"
        return 0
    fi
    say "SELinux: osada's module (osada runs confined as osada_t)"
    if [ ! -e /usr/share/selinux/devel/Makefile ]; then
        echo "  it needs selinux-policy-devel (dnf install selinux-policy-devel), then run this again" >&2
        exit 1
    fi
    local tmp=/tmp/osada-selinux.XXXX
    [ "$DRY" = 1 ] || tmp=$(mktemp -d)
    run cp "$HERE/selinux/osada.te" "$HERE/selinux/osada.fc" "$HERE/selinux/osada.if" "$tmp/"
    run make -C "$tmp" -f /usr/share/selinux/devel/Makefile osada.pp
    run semodule -i "$tmp/osada.pp"
    semanage fcontext -l -C 2>/dev/null | grep -qF "$1(/.*)?" || run semanage fcontext -a -t osada_data_t "$1(/.*)?"
    semanage port -l -C 2>/dev/null | grep -q '^osada_link_port_t' || run semanage port -a -t osada_link_port_t -p udp "$(port_of "$LINK")"
    run restorecon -RF "$BIN" /etc/osada "$1"
}

start_units() {
    if [ "$START" = 0 ] || ! real; then
        echo "  (not started: systemctl daemon-reload; systemctl enable --now $*)"
        return
    fi
    run systemctl daemon-reload
    run systemctl enable --now "$@"
}

case "$cmd" in
first)
    need_root
    NAME=${NAME:-$(host_name)}
    valid_name "$NAME" || { echo "--name: the node's name, small letters, digits and -" >&2; exit 2; }
    EDGE_NAME=${EDGE_NAME:-$NAME-edge}
    check_binary
    if [ "$EDGE" = 1 ]; then
        valid_name "$EDGE_NAME" || { echo "--edge-name: small letters, digits and -" >&2; exit 2; }
        PUBLIC=${PUBLIC:-$(my_addr)}
        [ -n "$PUBLIC" ] || { echo "--edge: give the address other nodes reach this machine at: --address <address>" >&2; exit 2; }
        [ "$(port_of "$LINK")" != 7442 ] || { echo "--edge: the edge's link is 7442; give the first node another (--link)" >&2; exit 2; }
    fi
    # the pages (plain http) where --http says; on this machine only unless asked (https: the edges)
    HTTP=${HTTP:-127.0.0.1:8096}
    if [ -n "$PUBLIC_NAME" ]; then
        valid_hosts "$PUBLIC_NAME" || { echo "--public-name: host names (a,b), small letters" >&2; exit 2; }
        ISSUER=${ISSUER:-https://${PUBLIC_NAME%%,*}}
    fi
    say "a new cluster; this machine is its first node, $NAME"
    install_binary
    make_user osada /var/lib/osada
    env_file="# osada 0.2 (osada-setup first, $(date -u +%F))
# the data: files, the wiki, the node's logs and the cluster's
OSADA_DATA=/var/lib/osada
# the pages and the API: plain http for the local network (the internet: an edge's https)
OSADA_BIND=$HTTP
# the links between nodes (UDP; other nodes dial it, or this node dials them: OSADA_PEERS)
OSADA_LINK_BIND=$LINK
# this node's name (people see it; its id is a GUID made at the first start)
OSADA_NODE=$NAME
"
    [ -n "$PUBLIC_NAME" ] && env_file+="# the instance: its address (links, federation, the UPN domain)
OSADA_PUBLIC_URL=https://${PUBLIC_NAME%%,*}
"
    [ -n "$ISSUER" ] && env_file+="# where programs signing in with osada (OpenID Connect) find it
OSADA_OIDC_ISSUER=$ISSUER
"
    [ -n "$PEER" ] && env_file+="# nodes this one dials (an edge reachable from here): name@host:port, space-separated
OSADA_PEERS=$PEER
"
    say "the settings: /etc/osada/osada.env"
    put /etc/osada/osada.env 640 "$env_file"
    real && chgrp osada /etc/osada/osada.env 2>/dev/null || true
    say "the services"
    port=$(port_of "$HTTP")
    caps=""
    [ "$port" -lt 1024 ] 2>/dev/null && caps="AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
"
    put /etc/systemd/system/osada.service 644 "[Unit]
Description=osada 0.2 ($NAME, the first node)
After=network-online.target
Wants=network-online.target

[Service]
User=osada
EnvironmentFile=/etc/osada/osada.env
ExecStart=$BIN serve
${caps}NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/osada
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
"
    put /etc/systemd/system/osada-web-agent.service 644 "[Unit]
Description=osada web agent: containers of sites and disks of this node (root)
After=network-online.target osada.service
Wants=network-online.target

[Service]
ExecStart=$BIN web-agent --data /var/lib/osada/node
Restart=on-failure
RestartSec=5
# podman leaves the containers' conmon in this service's cgroup: restarting the agent (an
# upgrade) must not take the sites' containers with it
KillMode=process

[Install]
WantedBy=multi-user.target
"
    selinux_module /var/lib/osada
    say "ports"
    case "$HTTP" in
        127.*|localhost:*|\[::1\]:*) open_ports "$(port_of "$LINK")/udp" ;;
        *) open_ports "$port/tcp" "$(port_of "$LINK")/udp" ;;
    esac
    say "start"
    start_units osada.service osada-web-agent.service
    admin_file=/var/lib/osada/node/first-admin
    if real && [ "$START" = 1 ]; then
        for _ in $(seq 1 30); do [ -e "$admin_file" ] && break; sleep 1; done
        [ -e "$admin_file" ] || echo "  (no $admin_file yet: journalctl -u osada says why)"
    fi
    if [ "$EDGE" = 1 ]; then
        say "the edge on this machine: node $EDGE_NAME (443, 80; its link on 7442, which this node dials at $PUBLIC)"
        if real && [ "$START" = 1 ]; then
            tok=$(runuser -u osada -- $BIN token --data /var/lib/osada/node --node "$EDGE_NAME" --roles "$ROLES" --hours 1 --dial "$PUBLIC:7442" 2>/dev/null)
            [ -n "$tok" ] || { echo "  no token for the edge (journalctl -u osada)" >&2; exit 1; }
            fw=(); [ "$FIREWALL" = 1 ] && fw=(--firewall)
            OSADA_INSTALL_NESTED=1 "$0" node --name "$EDGE_NAME" --token "$tok" --edge --link 0.0.0.0:7442 --wait 5 "${fw[@]}" | sed 's/^/  │ /'
            if [ -n "$PUBLIC_NAME" ]; then
                say "a certificate for $PUBLIC_NAME (issued by $EDGE_NAME once DNS points at $PUBLIC)"
                for _ in $(seq 1 30); do
                    runuser -u osada -- $BIN dial --data /var/lib/osada/node 2>/dev/null | grep -q "^$PUBLIC:7442 .* [0-9a-f-]\{36\}$" && break
                    sleep 1
                done
                cert_import /var/lib/osada/node "$CERT" "$PUBLIC_NAME" "$EDGE_NAME" || true
            fi
        else
            echo "  (not now: --no-start or a dry run)"
        fi
    fi
    say "next"
    echo "  1. the pages: $HTTP (plain http) here$( case "$HTTP" in 127.*) echo "; from another machine: ssh -L 8096:$HTTP root@<this machine>, then http://localhost:8096/";; esac )"
    echo "     sign in as admin; the password: cat $admin_file (change it on the account page)"
    if [ "$EDGE" = 1 ]; then
        echo "  2. DNS: ${PUBLIC_NAME:-your public name} → the edges' addresses (this one: $PUBLIC; A, and AAAA for IPv6)"
        [ -n "$PUBLIC_NAME" ] && echo "     within minutes of DNS answering: https://${PUBLIC_NAME%%,*}/" \
            || echo "     then a certificate: $SELF cert --names <your public name> (or admin → nodes → certificates)"
    else
        echo "  2. an edge (a node that answers https for your name): here $SELF token --name <its name> --at <its address>,"
        echo "     then on it the $SELF node … line printed; then DNS and $SELF cert --names <your name> here"
    fi
    echo "  3. more nodes, anywhere: here $SELF token --name <its name> --at <its address>"
    ;;
token)
    need_root
    valid_name "$NAME" || { echo "--name: the new node's name" >&2; exit 2; }
    env_file="$ROOT/etc/osada/osada.env"
    [ -r "$env_file" ] || { echo "no $env_file: run this on the first node" >&2; exit 1; }
    data=$(sed -n 's/^OSADA_DATA=//p' "$env_file" | tail -1)
    data="$ROOT${data:-/var/lib/osada}"
    lport=$(sed -n 's/^OSADA_LINK_BIND=//p' "$env_file" | tail -1)
    lport=$(port_of "${lport:-$LINK}")
    first_name=$(sed -n 's/^OSADA_NODE=//p' "$env_file" | tail -1)
    dial=()
    if [ -n "$AT" ]; then
        case "$AT" in
            \[*\]:*) at=$AT ;;                       # [v6]:port
            *:*:*) at="[$AT]:$lport" ;;               # a bare IPv6 address
            *:*) at=$AT ;;                            # host:port
            *) at="$AT:$lport" ;;
        esac
        dial=(--dial "$at")
    fi
    # the token alone on stdout (T=$($SELF token …)); the rest on stderr
    say "a one-time token for $NAME (roles $ROLES), valid $HOURS h" >&2
    if [ -n "$ROOT" ] || [ "$(id -un)" = osada ]; then
        tok=$("$ROOT$BIN" token --data "$data/node" --node "$NAME" --roles "$ROLES" --hours "$HOURS" "${dial[@]}" 2>/dev/null)
    else
        tok=$(runuser -u osada -- $BIN token --data "$data/node" --node "$NAME" --roles "$ROLES" --hours "$HOURS" "${dial[@]}" 2>/dev/null)
    fi
    [ -n "$tok" ] || { echo "no token made (is osada running here? journalctl -u osada)" >&2; exit 1; }
    echo "$tok"
    me=$(hostname -I 2>/dev/null | awk '{print $1}')
    {
        if [ -n "$AT" ]; then
            echo "  this node now dials $NAME at $at (and keeps doing so: osada dial --data $data/node lists it)"
        else
            echo "  without --at, $NAME must reach this node itself (--peer); for an edge, --at <its address> is simpler"
        fi
        say "on $NAME, as root:"
        edge=""
        [[ ",$ROLES," == *,edge-http,* ]] && edge=" --edge"
        echo "  $SELF node --name $NAME --token $tok$edge --firewall$( [ -z "$AT" ] && echo " --peer ${first_name:-<this node>}@${me:-<this node>}:$lport")"
    } >&2
    ;;
node)
    need_root
    valid_name "$NAME" || { echo "--name: this node's name, as in the token" >&2; exit 2; }
    [ -n "$TOKEN" ] || { echo "--token is needed ($SELF token --name $NAME --at <this VM's address> on the first node)" >&2; exit 2; }
    check_binary
    say "$NAME joins the cluster${PEER:+ (dialing $PEER too)}"
    install_binary
    make_user osada-node /var/lib/osada-node
    # the link port first: the first node dials it for the join
    say "ports"
    if [ "$EDGE" = 1 ]; then open_ports http https "$(port_of "$LINK")/udp"; else open_ports "$(port_of "$LINK")/udp"; fi
    data="$ROOT/var/lib/osada-node/node"
    join=(join --node "$NAME" --token "$TOKEN" --listen "$LINK" --wait "$WAIT")
    [ -n "$PEER" ] && join+=(--peer "$PEER")
    shown="--node $NAME --token … --listen $LINK${PEER:+ --peer $PEER}"
    say "the join"
    if [ -e "$data/store.db" ]; then
        echo "  = $data has a node already: not joined again"
    elif [ "$DRY" = 1 ]; then
        echo "  + osada join --data /var/lib/osada-node/node $shown"
    else
        if [ -n "$ROOT" ]; then
            echo "  + osada join --data $data $shown"
            "$ROOT$BIN" "${join[@]}" --data "$data"
        else
            echo "  + osada join --data /var/lib/osada-node/node $shown"
            echo "  (the first node dials this VM at UDP $(port_of "$LINK") when its token was made with --at; up to $WAIT min)"
            runuser -u osada-node -- $BIN "${join[@]}" --data /var/lib/osada-node/node
        fi
    fi
    relay=""
    caps=""
    if [ "$EDGE" = 1 ]; then
        relay=" \\
    --relay [::]:443 --relay-http [::]:80"
        caps="AmbientCapabilities=CAP_NET_BIND_SERVICE
