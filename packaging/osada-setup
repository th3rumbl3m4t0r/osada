    STALWART_NODE_DATA=$ndata STALWART_NODE_USER=$nuser python3 -I - <<'EOF' || exit 1
import base64, json, os, pwd, time, urllib.request
cred = [l.split("=", 1)[1].strip() for l in open("/opt/stalwart/etc/stalwart.env") if l.startswith("STALWART_RECOVERY_ADMIN=")][0]
auth = "Basic " + base64.b64encode(cred.encode()).decode()
def req(method, url, body=None):
    r = urllib.request.Request(url, method=method, headers={"Authorization": auth, "Content-Type": "application/json"},
                               data=None if body is None else json.dumps(body).encode())
    with urllib.request.urlopen(r, timeout=20) as f:
        return json.loads(f.read())
for base in ("http://127.0.0.1:8080", "http://[::1]:8080"):
    try:
        s = req("GET", base + "/jmap/session"); break
    except OSError:
        s = None
if s is None:
    raise SystemExit("  ! Stalwart does not answer on 8080: journalctl -u stalwart")
acct = s["primaryAccounts"].get("urn:stalwart:jmap") or next(iter(s["accounts"]))
api = base + "/" + s["apiUrl"].split("://", 1)[-1].split("/", 1)[1]
def call(m, a):
    a["accountId"] = acct
    return req("POST", api, {"using": ["urn:ietf:params:jmap:core", "urn:stalwart:jmap"], "methodCalls": [[m, a, "0"]]})["methodResponses"][0][1]
